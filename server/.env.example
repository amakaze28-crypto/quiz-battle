PORT=3001
# カンマ区切りで許可するフロントのURL（開発中は * でOK）
CLIENT_ORIGIN=http://localhost:5173
# Firebase Admin のサービスアカウントJSONを1行にしたもの。未設定だと開発モード(メモリ保存・dev:名前 トークン)で動きます
FIREBASE_SERVICE_ACCOUNT=
# 管理者にするGoogleアカウントのメール（カンマ区切り）。このアカウントでログインすると管理者画面が使えます
ADMIN_EMAILS=
# テスト用の上書き（通常は不要）
# MATCH_SIZE=4
# QUESTION_TIME_MS=60000
